# mlat-bench environment. Copy to .env and adjust; every value has a working
# default — an empty .env is valid.

# Oracle ports (host side; always bound to 127.0.0.1 by compose).
ORACLE_CLIENT_PORT=40147
ORACLE_SBS_PORT=40148
ORACLE_SBS_FILTERED_PORT=40149

# Where the oracle writes results.csv / sync.json when run standalone.
# The orchestrator overrides this per run.
ORACLE_WORK_DIR=./work
